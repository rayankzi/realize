# Database connection for Drizzle (libSQL).
#
# Local development uses a SQLite file:
DATABASE_URL="file:./data/realize.db"

# To switch to a hosted Turso database later, change the URL to your libsql://
# endpoint and provide the auth token — no application code changes needed:
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="your-token"
